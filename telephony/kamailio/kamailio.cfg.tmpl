#!KAMAILIO
#
# Mira Voice — SIP edge (Kamailio 6.1).
# Rendered by entrypoint.sh: ${MIRA_LOCAL_IP}, ${MIRA_PUBLIC_IP}, ${MIRA_SIP_DOMAIN} and
# ${KAMAILIO_RPC_TOKEN} come from /opt/mira/.env. Do not hand-edit a running server (CLAUDE.md); change this template.
#
# Role:
#   phones / browsers  --UDP, TCP, TLS 5061, WSS 8089-->  Kamailio  --UDP 127.0.0.1-->  Asterisk :5080
#   media: client <--RTP / SRTP / DTLS-SRTP--> RTPengine (external) <--RTP 127.0.0.1--> Asterisk
#
# Asterisk is the registrar and authenticates every REGISTER and INVITE (digest).
# Kamailio adds a Path header on REGISTER, so Asterisk sends calls to a phone back through
# Kamailio, which delivers them to the address (and connection) the phone registered from.
#
# Carriers (task 1.2, ADR 0007): dispatcher set 2, generated by Mira Core, lists the
# signalling IPs of each trunk. A request from one of them gets the header
# X-Mira-Trunk: trunk_<id>, which Asterisk uses to pick the trunk endpoint. Kamailio removes
# that header from everything else, so a phone cannot pretend to be a carrier.

####### Defines #########
#!define FLT_NATS 5
#!define FLT_FROM_PBX 7
#!define FLT_CLIENT_WS 8
#!define FLB_NATB 6
#!define FLT_FROM_CARRIER 9

#!define PBX_SET 1
#!define CARRIER_SET 2
#!define RTP_TO_PBX "direction=external direction=internal replace-origin replace-session-connection ICE=remove RTP/AVP rtcp-mux-demux SDES-off DTLS=off"
#!define RTP_TO_WEBRTC "direction=internal direction=external replace-origin replace-session-connection ICE=force UDP/TLS/RTP/SAVPF rtcp-mux-offer rtcp-mux-require SDES-off"
# SDES towards SIP-TLS phones: only the suites every SRTP phone supports (RFC 4568
# AES_CM_128_HMAC_SHA1_80/_32). Offering the GCM suites broke an older softphone in the lab test.
#!define RTP_TO_SRTP "direction=internal direction=external replace-origin replace-session-connection ICE=remove RTP/SAVP DTLS=off SDES-only-AES_CM_128_HMAC_SHA1_80 SDES-only-AES_CM_128_HMAC_SHA1_32"
#!define RTP_TO_RTP "direction=internal direction=external replace-origin replace-session-connection ICE=remove RTP/AVP DTLS=off"

####### Global parameters #########
debug=2
log_stderror=yes
log_prefix="{$mt $hdr(CSeq) $ci} "
children=8
tcp_children=8
auto_aliases=no
# Aliases always carry a port: an alias without one means "every port on this host is me",
# which would also swallow a phone or browser that shares the server's IP.
alias="${MIRA_SIP_DOMAIN}:5060"
alias="${MIRA_SIP_DOMAIN}:5061"
alias="${MIRA_SIP_DOMAIN}:8089"
alias="${MIRA_PUBLIC_IP}:5060"
alias="${MIRA_PUBLIC_IP}:5061"
alias="${MIRA_PUBLIC_IP}:8089"

# Public sockets first: Kamailio uses the first matching socket when none is forced.
listen=udp:${MIRA_LOCAL_IP}:5060 advertise ${MIRA_PUBLIC_IP}:5060
listen=tcp:${MIRA_LOCAL_IP}:5060 advertise ${MIRA_PUBLIC_IP}:5060
listen=tls:${MIRA_LOCAL_IP}:5061 advertise ${MIRA_PUBLIC_IP}:5061
listen=tls:${MIRA_LOCAL_IP}:8089 advertise ${MIRA_PUBLIC_IP}:8089
# Internal socket towards Asterisk
listen=udp:127.0.0.1:5060
# JSON-RPC over HTTP for Mira Core (dispatcher.reload), loopback only, token-protected
listen=tcp:127.0.0.1:8095

enable_tls=yes
tcp_accept_no_cl=yes
tcp_connection_lifetime=3605
tcp_max_connections=4096
tls_max_connections=4096
user_agent_header="User-Agent: Mira Voice"
server_header="Server: Mira Voice"
sip_warning=0

####### Modules #########
loadmodule "jsonrpcs.so"
loadmodule "kex.so"
loadmodule "corex.so"
loadmodule "tm.so"
loadmodule "tmx.so"
loadmodule "sl.so"
loadmodule "rr.so"
loadmodule "path.so"
loadmodule "pv.so"
loadmodule "maxfwd.so"
loadmodule "textops.so"
loadmodule "siputils.so"
loadmodule "xlog.so"
loadmodule "sanity.so"
loadmodule "ctl.so"
loadmodule "cfg_rpc.so"
loadmodule "htable.so"
loadmodule "pike.so"
loadmodule "nathelper.so"
loadmodule "dispatcher.so"
loadmodule "rtpengine.so"
loadmodule "tls.so"
loadmodule "xhttp.so"
loadmodule "websocket.so"

####### Module parameters #########
# HTTP only (served by event_route[xhttp:request] on 127.0.0.1:8095); kamcmd uses ctl
modparam("jsonrpcs", "transport", 1)
modparam("ctl", "binrpc", "unix:/run/kamailio/kamailio_ctl")

modparam("tm", "failure_reply_mode", 3)
modparam("tm", "fr_timer", 30000)
modparam("tm", "fr_inv_timer", 120000)

modparam("rr", "enable_double_rr", 1)
modparam("rr", "append_fromtag", 0)

# Route to the "received" address stored in the Path of the registration
modparam("path", "use_received", 1)

# Generated by Mira Core (entrypoint.sh links it); set 1 = Asterisk, set 2 = carrier IPs
modparam("dispatcher", "list_file", "/etc/kamailio/dispatcher.list")
# attributes of the matched address (duid=...;trunk=trunk_<id>) after ds_is_from_list()
modparam("dispatcher", "attrs_pvname", "$avp(dsattrs)")
# Mira Core reloads after every trunk change; it retries a reload refused within this delay
modparam("dispatcher", "reload_delta", 1)
modparam("dispatcher", "ds_ping_method", "OPTIONS")
modparam("dispatcher", "ds_ping_from", "sip:mira-edge@${MIRA_SIP_DOMAIN}")
modparam("dispatcher", "ds_ping_interval", 10)
modparam("dispatcher", "ds_probing_mode", 1)
modparam("dispatcher", "ds_ping_reply_codes", "class=2;code=401;code=403;code=404;code=405")

modparam("rtpengine", "rtpengine_sock", "udp:127.0.0.1:2223")

modparam("nathelper", "natping_interval", 0)

modparam("tls", "config", "/etc/kamailio/tls.cfg")

modparam("websocket", "keepalive_mechanism", 1)
modparam("websocket", "keepalive_timeout", 30)

# Flood protection: more than 30 requests per 2 s from one IP => blocked for 5 minutes
modparam("pike", "sampling_time_unit", 2)
modparam("pike", "reqs_density_per_unit", 30)
modparam("pike", "remove_latency", 4)
modparam("htable", "htable", "ipban=>size=8;autoexpire=300;")

####### Routing #########

request_route {
	route(CARRIER_ID);
	route(REQINIT);
	route(NATDETECT);

	if (is_method("CANCEL")) {
		if (t_check_trans()) {
			route(RELAY);
		}
		exit;
	}

	if (!is_method("ACK")) {
		if (t_precheck_trans()) {
			t_check_trans();
			exit;
		}
		t_check_trans();
	}

	route(WITHINDLG);

	# ----- initial requests -----
	if (is_method("INVITE|SUBSCRIBE|REFER")) {
		record_route();
	}

	if (ds_is_from_list(PBX_SET)) {
		route(FROM_PBX);
	}
	if (isflagset(FLT_FROM_CARRIER)) {
		route(FROM_CARRIER);
	}
	route(TO_PBX);
}

# Which trunk is this? Only Kamailio may say: the header is removed from every request that
# does not come from Asterisk, then added back for a known carrier address (IP only: carriers
# use other ports and transports than the ones listed).
route[CARRIER_ID] {
	if (ds_is_from_list(PBX_SET)) return;
	remove_hf("X-Mira-Trunk");
	if (!ds_is_from_list(CARRIER_SET, "3")) return;
	$var(trunk) = $(avp(dsattrs){param.value,trunk});
	if ($var(trunk) =~ "^trunk_[0-9a-f]{32}$") {
		setflag(FLT_FROM_CARRIER);
	}
}

# Basic checks, flood and scanner protection
route[REQINIT] {
	# carriers are trusted peers: never flood-blocked
	if (!ds_is_from_list(PBX_SET) && !isflagset(FLT_FROM_CARRIER)) {
		if ($sht(ipban=>$si) != $null) {
			exit;
		}
		if (!pike_check_req()) {
			xlog("L_ALERT", "pike: blocking $rm from $fu ($si:$sp)\n");
			$sht(ipban=>$si) = 1;
			exit;
		}
	}
	if ($ua =~ "friendly-scanner|sipcli|sipvicious|VaxSIPUserAgent|sipsak") {
		exit;
	}
	if (!mf_process_maxfwd_header("10")) {
		sl_send_reply("483", "Too Many Hops");
		exit;
	}
	if (is_method("OPTIONS") && uri == myself && $rU == $null) {
		sl_send_reply("200", "Keepalive");
		exit;
	}
	if (!sanity_check()) {
		xlog("L_WARN", "malformed SIP request from $si:$sp\n");
		exit;
	}
}

# NAT detection. WebSocket clients always count as NATed.
route[NATDETECT] {
	force_rport();
	if ($pr =~ "^ws") {
		setflag(FLT_NATS);
		if (is_first_hop()) {
			route(WS_CONTACT);
		}
	} else if (nat_uac_test("19")) {
		if (!is_method("REGISTER") && is_first_hop()) {
			set_contact_alias();
		}
		setflag(FLT_NATS);
	}
}

# Browsers send Contact <sip:x@random.invalid;transport=ws>. Asterisk has no WebSocket
# transport and refuses to address such a URI, so replace it with the real source address
# plus an alias (ip~port~proto) that handle_ruri_alias() turns back into this WS connection.
route[WS_CONTACT] {
	if (!is_present_hf("Contact") || $ct == "*") return;
	$var(cuser) = $(ct{tobody.user});
	$var(cparams) = $(ct{tobody.params});
	# {tobody.params} returns the header parameters without their leading ";"
	if ($var(cparams) == $null || $var(cparams) == "") {
		$var(cparams) = "";
	} else {
		$var(cparams) = ";" + $var(cparams);
	}
	remove_hf("Contact");
	append_hf("Contact: <sip:$var(cuser)@$si:$sp;alias=$si~$sp~$prid>$var(cparams)\r\n");
}

# Requests inside an established dialog
route[WITHINDLG] {
	if (!has_totag()) return;

	if (loose_route()) {
		if (!isdsturiset()) {
			handle_ruri_alias();
		}
		if (is_method("BYE")) {
			rtpengine_delete();
		} else if (is_method("INVITE|UPDATE") || (is_method("ACK") && has_body("application/sdp"))) {
			route(MEDIA);
		}
		route(RELAY);
		exit;
	}
	if (is_method("ACK")) {
		if (t_check_trans()) {
			route(RELAY);
		}
		exit;
	}
	sl_send_reply("404", "Not here");
	exit;
}

# Initial request from Asterisk to a phone (call, qualify OPTIONS, NOTIFY).
# The Route header is the Path stored at registration; loose_route() takes the
# "received" address from it as the destination.
route[FROM_PBX] {
	loose_route();
	# Asterisk registering a trunk to a carrier: give the carrier our public address instead
	# of 127.0.0.1:5080; its calls then come to us and on to Asterisk (route FROM_CARRIER).
	if (is_method("REGISTER")) {
		if ($(ru{uri.transport}) == "tls") {
			subst_hf("Contact", "/@127[.]0[.]0[.]1:5080/@${MIRA_PUBLIC_IP}:5061;transport=tls/", "f");
		} else if ($(ru{uri.transport}) == "tcp") {
			subst_hf("Contact", "/@127[.]0[.]0[.]1:5080/@${MIRA_PUBLIC_IP}:5060;transport=tcp/", "f");
		} else {
			subst_hf("Contact", "/@127[.]0[.]0[.]1:5080/@${MIRA_PUBLIC_IP}:5060/", "f");
		}
	}
	# Contact registered through WS_CONTACT: restore the WebSocket destination, drop the alias
	if ($ru =~ ";alias=") {
		handle_ruri_alias();
	}
	if (is_method("INVITE")) {
		route(MEDIA);
	}
	route(RELAY);
}

# Initial request from a carrier: tag it with its trunk and hand it to Asterisk.
route[FROM_CARRIER] {
	if (is_method("OPTIONS")) {
		sl_send_reply("200", "OK");
		exit;
	}
	if (!is_method("INVITE")) {
		sl_send_reply("405", "Method Not Allowed");
		exit;
	}
	# A registration trunk is called on the Contact we registered (sip:trunk_<id>@...):
	# the number that was dialled (the DID) is in the To header.
	if ($rU =~ "^trunk_[0-9a-f]{32}$") {
		$rU = $tU;
	}
	append_hf("X-Mira-Trunk: $var(trunk)\r\n");
	if (!ds_select_dst(PBX_SET, "1")) {
		send_reply("503", "Service Unavailable");
		exit;
	}
	route(MEDIA);
	route(RELAY);
}

# Initial request from a phone or browser: hand it to Asterisk.
route[TO_PBX] {
	if (!uri == myself) {
		sl_send_reply("403", "Relaying forbidden");
		exit;
	}
	if (is_method("REGISTER")) {
		add_path_received();
		if (!search_hf("Supported", "path", "a")) {
			append_hf("Supported: path\r\n");
		}
	}
	# Same user -> same Asterisk node (hash over the From URI)
	if (!ds_select_dst(PBX_SET, "1")) {
		send_reply("503", "Service Unavailable");
		exit;
	}
	if (is_method("INVITE")) {
		route(MEDIA);
	}
	route(RELAY);
}

# Media through RTPengine. Towards Asterisk: plain RTP on 127.0.0.1.
# Towards a phone: what its transport implies (WSS => WebRTC DTLS-SRTP, TLS => SRTP, else RTP).
route[MEDIA] {
	if (!has_body("application/sdp")) return;

	if (ds_is_from_list(PBX_SET)) {
		setflag(FLT_FROM_PBX);
		if (isdsturiset()) {
			$var(tp) = $(du{uri.transport});
		} else {
			$var(tp) = $(ru{uri.transport});
		}
		if ($var(tp) =~ "^ws") {
			rtpengine_manage(RTP_TO_WEBRTC);
		} else if ($var(tp) == "tls") {
			rtpengine_manage(RTP_TO_SRTP);
		} else {
			rtpengine_manage(RTP_TO_RTP);
		}
	} else {
		if ($proto =~ "^ws") {
			setflag(FLT_CLIENT_WS);
		}
		rtpengine_manage(RTP_TO_PBX);
	}
	t_on_reply("MEDIA_REPLY");
	t_on_failure("MEDIA_FAILED");
}

route[RELAY] {
	# Always pick the outgoing socket explicitly. Record-Route (double RR) is completed from
	# the socket actually used, so a guessed socket would break the rest of the dialog —
	# e.g. WebSocket clients are only on the WSS listener (8089), never on 5060.
	if (isdsturiset()) {
		$var(nh) = $(du{uri.host});
		$var(np) = $(du{uri.transport});
	} else {
		$var(nh) = $rd;
		$var(np) = $(ru{uri.transport});
	}
	if ($var(nh) == "127.0.0.1") {
		force_send_socket(udp:127.0.0.1:5060);
	} else if ($var(np) =~ "^ws") {
		force_send_socket(tls:${MIRA_LOCAL_IP}:8089);
	} else if ($var(np) == "tls") {
		force_send_socket(tls:${MIRA_LOCAL_IP}:5061);
	} else if ($var(np) == "tcp") {
		force_send_socket(tcp:${MIRA_LOCAL_IP}:5060);
	} else {
		force_send_socket(udp:${MIRA_LOCAL_IP}:5060);
	}
	if (!t_relay()) {
		sl_reply_error();
	}
	exit;
}

# All replies: keep NATed / WebSocket contacts reachable for in-dialog requests.
onreply_route {
	if ($pr =~ "^ws") {
		route(WS_CONTACT);
	} else if ($si != "127.0.0.1" && status =~ "^[12][0-9][0-9]$" && nat_uac_test("1")) {
		set_contact_alias();
	}
}

onreply_route[MEDIA_REPLY] {
	if (!has_body("application/sdp")) return;
	if (isflagset(FLT_FROM_PBX)) {
		# answer from the phone, going back to Asterisk
		rtpengine_manage("replace-origin replace-session-connection ICE=remove");
	} else if (isflagset(FLT_CLIENT_WS)) {
		# answer from Asterisk, going back to a browser
		rtpengine_manage("replace-origin replace-session-connection ICE=force rtcp-mux-require");
	} else {
		rtpengine_manage("replace-origin replace-session-connection ICE=remove");
	}
}

failure_route[MEDIA_FAILED] {
	rtpengine_delete();
}

# WebSocket handshake on the WSS port (8089). A plain HTTPS GET gets a short page, so a
# browser can be pointed at https://<server>:8089 once to accept a self-signed certificate.
event_route[xhttp:request] {
	set_reply_close();
	set_reply_no_connect();

	# Mira Core's JSON-RPC (POST /RPC), loopback only, with the shared token
	if ($Rp == 8095) {
		if ($si != "127.0.0.1" || $Ri != "127.0.0.1" || !($hu =~ "^/RPC")
				|| $hdr(X-Mira-Token) != "${KAMAILIO_RPC_TOKEN}") {
			xlog("L_WARN", "rpc: refused $rm $hu from $si\n");
			xhttp_reply("403", "Forbidden", "", "");
			exit;
		}
		jsonrpc_dispatch();
		exit;
	}
	if ($Rp != 8089) {
		xhttp_reply("403", "Forbidden", "", "");
		exit;
	}
	if ($hdr(Upgrade) =~ "websocket" && $hdr(Connection) =~ "Upgrade" && $rm =~ "GET") {
		if ($hdr(Host) == $null || !is_myself("sip:" + $(hdr(Host){s.select,0,:}))) {
			xlog("L_WARN", "websocket: bad Host $hdr(Host) from $si\n");
			xhttp_reply("403", "Forbidden", "", "");
			exit;
		}
		if (ws_handle_handshake()) {
			exit;
		}
	}
	xhttp_reply("200", "OK", "text/plain", "Mira Voice SIP over WebSocket endpoint is up.\n");
}
