*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.dart text eol=lf
*.conf text eol=lf
*.cfg text eol=lf
Dockerfile text eol=lf

