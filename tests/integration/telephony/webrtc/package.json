{
  "name": "mira-telephony-webrtc-test",
  "private": true,
  "description": "Mira Voice lab: WebRTC calls over WSS through Kamailio, RTPengine and Asterisk (task 0.3)",
  "type": "module",
  "scripts": {
    "build": "esbuild node_modules/jssip/lib/JsSIP.js --bundle --format=iife --global-name=JsSIP --platform=browser --minify --outfile=vendor/jssip.min.js",
    "serve": "npm run build && python3 -m http.server 8765 --bind 127.0.0.1",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "esbuild": "0.28.2",
    "jssip": "3.13.9"
  }
}
